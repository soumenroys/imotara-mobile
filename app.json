      "./plugins/withAndroidRawSounds",
      "./plugins/withAndroidTextBounds",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResources": true,
            "extraProguardRules": "# ── Imotara: keep rules the prebuilt Expo artifacts do NOT ship ──\n# Found on a real Galaxy A27, 2026-09-16: daily check-in reminders could never be\n# enabled in a release build. expo-notifications persists a scheduled request with\n# Java ObjectOutputStream; NotificationContent has private writeObject/readObject hooks\n# that serialize its JSONObject body as a string. R8 stripped those hooks (they are\n# only reached reflectively), Java fell back to default field serialization, hit\n# `org.json.JSONObject mBody` and threw NotSerializableException. The library's own\n# `-keep class expo.modules.notifications.** {*;}` exists in its SOURCE repo but the\n# published AAR carries no proguard.txt, so it never reaches this app's R8.\n-keep class expo.modules.notifications.** { *; }\n# The standard rule every Serializable class needs under R8 — restores the hooks for\n# any other module in the same situation.\n-keepclassmembers class * implements java.io.Serializable {\n    static final long serialVersionUID;\n    private static final java.io.ObjectStreamField[] serialPersistentFields;\n    private void writeObject(java.io.ObjectOutputStream);\n    private void readObject(java.io.ObjectInputStream);\n    java.lang.Object writeReplace();\n    java.lang.Object readResolve();\n}",
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "scheme": "imotara",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d035812a-a728-4703-85a5-f8e957e233bf"
