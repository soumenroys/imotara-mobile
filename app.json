{
  "expo": {
    "name": "Imotara",
    "slug": "imotara-mobile",
    "version": "1.6.2",
    "description": "Imotara is a private, emotion-aware companion that helps you understand your feelings, track your mood, and grow emotionally — without ads, paywalls, or data tracking. Supports 22 languages including Bengali, Hindi, Tamil, Telugu, and more. Designed for mental wellness, mindfulness, and building healthier relationships with technology.",
