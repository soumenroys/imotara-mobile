{
  "name": "imotara-mobile",
  "version": "1.7.2",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:version": "node scripts/check-version-sync.js",
    "postinstall": "patch-package",
    "check:r8": "node scripts/check-r8-serializable.js"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^expo-audio$": "<rootDir>/jest/stubs/expo-audio.js",
      "^expo-audio/build/AudioModule$": "<rootDir>/jest/stubs/expo-audio-module.js",
      "^expo-audio/build/utils/options$": "<rootDir>/jest/stubs/expo-audio-options.js",
      "^expo-speech$": "<rootDir>/jest/stubs/expo-speech.js",
      "^expo-file-system$": "<rootDir>/jest/stubs/expo-file-system.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/jest/stubs/async-storage.js"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|react-native-razorpay))"
    ]
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/native": "^7.1.24",
    "@sentry/react-native": "^8.23.0",
    "@supabase/supabase-js": "^2.99.1",
    "expo": "^55.0.0",
    "expo-apple-authentication": "~55.0.17",
    "expo-application": "~55.0.19",
    "expo-asset": "~55.0.20",
    "expo-audio": "~55.0.18",
    "expo-auth-session": "~55.0.19",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-iap": "^3.4.13",
    "expo-image-picker": "~55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-navigation-bar": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.25",
    "expo-speech": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.18",
    "expo-updates": "~55.0.33",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-razorpay": "^3.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "expo-dev-client": "~55.0.41",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-razorpay"
        ]
      }
    },
    "install": {
      "exclude": [
        "@sentry/react-native",
        "@types/jest"
      ]
    }
  },
  "private": true
}
